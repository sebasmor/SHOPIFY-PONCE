{%- comment -%}
  Cuadrícula de departamentos. Cada departamento enlaza a /collections/<identificador>.
{%- endcomment -%}
<div class="section section--page-width" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
  <div class="ta-section-head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a href="{{ routes.collections_url }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
  <div class="ta-deps">
    {%- for block in section.blocks -%}
      {%- liquid
        assign ta_handle = block.settings.handle | strip | handleize
        if ta_handle != blank
          assign ta_url = routes.collections_url | append: '/' | append: ta_handle
        else
          assign ta_url = routes.all_products_collection_url
        endif
      -%}
      <a class="ta-dep" href="{{ ta_url }}" {{ block.shopify_attributes }}>
        <span class="ta-dep__icon">{%- render 'todoaqui-icon', name: block.settings.icon -%}</span>
        {{ block.settings.title }}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Departamentos Todo Aquí",
  "tag": "section",
  "class": "ta-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Compra por departamento" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver todos" },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "departamento",
      "name": "Departamento",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Departamento" },
        {
          "type": "text", "id": "handle", "label": "Identificador de la colección",
          "info": "El final de la dirección de la colección. Ej.: para /collections/ferreteria escribe ferreteria"
        },
        {
          "type": "select", "id": "icon", "label": "Ícono", "default": "bag",
          "options": [
            { "value": "hammer", "label": "Martillo" }, { "value": "tool", "label": "Herramienta" },
            { "value": "helmet", "label": "Casco" }, { "value": "pot", "label": "Olla" },
            { "value": "headphones", "label": "Audífonos" }, { "value": "phone", "label": "Celular" },
            { "value": "beauty", "label": "Belleza" }, { "value": "toy", "label": "Juguete" },
            { "value": "gift", "label": "Regalo" }, { "value": "tag", "label": "Etiqueta de oferta" },
            { "value": "bag", "label": "Bolsa de compras" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Departamentos Todo Aquí",
      "blocks": [
        { "type": "departamento", "settings": { "title": "Ferretería", "handle": "ferreteria", "icon": "hammer" } },
        { "type": "departamento", "settings": { "title": "Herramientas", "handle": "herramientas", "icon": "tool" } },
        { "type": "departamento", "settings": { "title": "Hogar y cocina", "handle": "hogar-cocina", "icon": "pot" } }
      ]
    }
  ]
}
{% endschema %}
