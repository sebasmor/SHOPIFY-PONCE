{%- comment -%}
  Portada de Todo Aquí: banner principal verde y dos promociones al lado.
{%- endcomment -%}
<div class="section section--page-width" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
  <div class="ta-hero">
    <div class="ta-hero__main">
      <div class="ta-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ta-hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="ta-hero__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="ta-hero__text">{{ section.settings.text }}</p>
        {%- endif -%}
        <div class="ta-hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="ta-btn ta-btn--yellow" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.show_whatsapp_button -%}
            {%- capture ta_hero_wa -%}
              {%- render 'todoaqui-whatsapp-url', message: section.settings.whatsapp_message -%}
            {%- endcapture -%}
            <a class="ta-btn ta-btn--ghost" href="{{ ta_hero_wa | strip }}" target="_blank" rel="noopener">
              {%- render 'todoaqui-icon', name: 'whatsapp' -%}
              {{- section.settings.whatsapp_label -}}
            </a>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.image != blank -%}
        <div class="ta-hero__image">
          {{ section.settings.image | image_url: width: 600 | image_tag: loading: 'eager', sizes: '280px', alt: section.settings.image.alt }}
        </div>
      {%- endif -%}
    </div>

    <div class="ta-hero__side">
      {%- if section.settings.promo1_title != blank -%}
        <a class="ta-promo ta-promo--yellow" href="{{ section.settings.promo1_link | default: routes.all_products_collection_url }}">
          <div>
            <p class="ta-promo__title">{{ section.settings.promo1_title }}</p>
            <p class="ta-promo__text">{{ section.settings.promo1_text }}</p>
          </div>
          {%- render 'todoaqui-icon', name: section.settings.promo1_icon -%}
        </a>
      {%- endif -%}
      {%- if section.settings.promo2_title != blank -%}
        <a class="ta-promo ta-promo--light" href="{{ section.settings.promo2_link | default: routes.all_products_collection_url }}">
          <div>
            <p class="ta-promo__title">{{ section.settings.promo2_title }}</p>
            <p class="ta-promo__text">{{ section.settings.promo2_text }}</p>
          </div>
          {%- render 'todoaqui-icon', name: section.settings.promo2_icon -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Portada Todo Aquí",
  "tag": "section",
  "class": "ta-section",
  "settings": [
    { "type": "header", "content": "Banner principal" },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Gran apertura" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Todo lo que buscas, sin salir de Ponce." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Te lo llevamos a tu casa y pagas cuando lo tienes en tus manos." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver productos" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "show_whatsapp_button", "label": "Mostrar botón de WhatsApp", "default": true },
    { "type": "text", "id": "whatsapp_label", "label": "Texto del botón de WhatsApp", "default": "Pídelo por WhatsApp" },
    { "type": "text", "id": "whatsapp_message", "label": "Mensaje de WhatsApp", "default": "Hola, quiero hacer un pedido en Todo Aquí." },
    { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" },
    { "type": "header", "content": "Promoción 1" },
    { "type": "text", "id": "promo1_title", "label": "Título", "default": "Ferretería en oferta" },
    { "type": "text", "id": "promo1_text", "label": "Texto", "default": "Herramientas, linternas y más" },
    { "type": "url", "id": "promo1_link", "label": "Enlace" },
    {
      "type": "select", "id": "promo1_icon", "label": "Ícono", "default": "tool",
      "options": [
        { "value": "tool", "label": "Herramienta" }, { "value": "hammer", "label": "Martillo" },
        { "value": "helmet", "label": "Casco" }, { "value": "pot", "label": "Olla" },
        { "value": "headphones", "label": "Audífonos" }, { "value": "phone", "label": "Celular" },
        { "value": "beauty", "label": "Belleza" }, { "value": "toy", "label": "Juguete" },
        { "value": "gift", "label": "Regalo" }, { "value": "tag", "label": "Etiqueta de oferta" },
        { "value": "bag", "label": "Bolsa de compras" }
      ]
    },
    { "type": "header", "content": "Promoción 2" },
    { "type": "text", "id": "promo2_title", "label": "Título", "default": "Cocina para tu casa" },
    { "type": "text", "id": "promo2_text", "label": "Texto", "default": "Ollas, licuadoras y más" },
    { "type": "url", "id": "promo2_link", "label": "Enlace" },
    {
      "type": "select", "id": "promo2_icon", "label": "Ícono", "default": "pot",
      "options": [
        { "value": "tool", "label": "Herramienta" }, { "value": "hammer", "label": "Martillo" },
        { "value": "helmet", "label": "Casco" }, { "value": "pot", "label": "Olla" },
        { "value": "headphones", "label": "Audífonos" }, { "value": "phone", "label": "Celular" },
        { "value": "beauty", "label": "Belleza" }, { "value": "toy", "label": "Juguete" },
        { "value": "gift", "label": "Regalo" }, { "value": "tag", "label": "Etiqueta de oferta" },
        { "value": "bag", "label": "Bolsa de compras" }
      ]
    },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Arriba", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Abajo", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 12 }
  ],
  "presets": [{ "name": "Portada Todo Aquí" }]
}
{% endschema %}
