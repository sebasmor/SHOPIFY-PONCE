{% doc %}
  Íconos de línea de Todo Aquí.

  @param {string} name - truck, cash, shield, whatsapp, hammer, tool, helmet, pot, headphones, phone, beauty, toy, gift, tag, bag, search
  @param {string} [class] - clase extra para el svg
{% enddoc %}
<svg
  class="ta-icon {{ class }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 10h4l3 3.2v3.3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'cash' -%}
      <rect x="2.5" y="6.5" width="19" height="11" rx="1.5"/><circle cx="12" cy="12" r="2.5"/>
    {%- when 'shield' -%}
      <path d="M12 3l7.5 3v5.5c0 4.7-3.2 7.8-7.5 9-4.3-1.2-7.5-4.3-7.5-9V6z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'whatsapp' -%}
      <path d="M4 20l1.3-3.9A8 8 0 1 1 8.2 19z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8c-1-.5-1.8-1.3-2.3-2.3l.8-1-1-2z"/>
    {%- when 'hammer' -%}
      <path d="M14 7l-9.5 9.5a1.8 1.8 0 0 0 2.5 2.5L16.5 9.5"/><path d="M12 5l3-2 6 6-2 3z"/>
    {%- when 'tool' -%}
      <path d="M14.5 5.5a4 4 0 0 0 4.9 4.9L10 19.8a2.1 2.1 0 0 1-3-3l9.4-9.4"/><path d="M14.5 5.5l2-2 1.5 1.5"/>
    {%- when 'helmet' -%}
      <path d="M4 16a8 8 0 0 1 16 0"/><path d="M2.5 16h19v2.5h-19z"/><path d="M10 8.5V6h4v2.5"/>
    {%- when 'pot' -%}
      <path d="M4 10h16v7a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z"/><path d="M2 10h20"/><path d="M8 7c1-1.5 7-1.5 8 0"/>
    {%- when 'headphones' -%}
      <path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4.5" height="6" rx="1.2"/><rect x="16.5" y="14" width="4.5" height="6" rx="1.2"/>
    {%- when 'phone' -%}
      <rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/>
    {%- when 'beauty' -%}
      <rect x="8" y="9" width="8" height="12" rx="2"/><path d="M10 9V5h4v4"/><path d="M10 13h4"/>
    {%- when 'toy' -%}
      <circle cx="12" cy="13" r="6"/><circle cx="7" cy="6.5" r="2"/><circle cx="17" cy="6.5" r="2"/><path d="M10 14.5c1 1 3 1 4 0"/>
    {%- when 'gift' -%}
      <rect x="4" y="10" width="16" height="10" rx="1"/><rect x="3" y="7" width="18" height="3" rx="1"/><path d="M12 7v13"/>
    {%- when 'tag' -%}
      <path d="M3.5 12.5V4h8.5l8.5 8.5-8.5 8.5z"/><circle cx="8" cy="8.5" r="1.3"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>
    {%- else -%}
      <path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
  {%- endcase -%}
</svg>
